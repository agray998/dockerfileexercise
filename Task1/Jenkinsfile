pipeline {
    agent any
    environment {
        dockerhub = credentials('dockerhub')
    }

    stages {
        // stage('Checkout') {
        //     steps {
        //         git url: 'https://github.com/agray998/dockerfileexercise',
        //             branch: 'main'
        //     }
        // }
        stage('Reset') {
            steps {
                dir('Task1') {
                    sh "docker compose -f compose.yaml down --rmi=all"
                }
            }
        }
        stage('Build') {
            steps {
                dir('Task1') {
                    sh 'docker compose -f compose.yaml build'
                }   
            }
        }
        stage('Push images') {
            steps {
                dir('Task1') {
                    sh "docker login -u ${dockerhub_USR} -p ${dockerhub_PSW}"
                    sh "docker compose -f compose.yaml push"
                    sh "docker logout"
                }
            }
        }
        stage('Deploy') {
            steps {
                dir('Task1') {
                    sh "docker compose -f compose.yaml up -d"
                }
            }
        }
    }
}
